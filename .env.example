# ==============================================================================
# Mini ERP F&B Environment Variables (Template / Example)
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_erp_fnb
POSTGRES_PORT=5432

# Backend Service Configuration (Golang)
PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/mini_erp_fnb?sslmode=disable

# Frontend Service Configuration (React + Vite)
VITE_API_BASE_URL=http://localhost:8080/api
